# Copy this file to .env and supply your own local configuration.
# Never commit .env or service-account credentials.
VITE_API_URL=http://127.0.0.1:3001/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
API_PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173
# Set a connection string for an empty PostgreSQL database.
DATABASE_URL=
DEV_AUTH_BYPASS=false
# Absolute path to your Firebase Admin JSON file OUTSIDE this repository.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
EMAIL_FROM=SecureVision AI <onboarding@resend.dev>
CONTACT_TO_EMAIL=
APP_PUBLIC_URL=http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional override: Python executable with ReportLab installed.
PDF_PYTHON_BIN=
PDF_TEMP_DIR=
